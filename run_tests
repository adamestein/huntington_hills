#!/usr/bin/env bash
set -euo pipefail

export BDD_BROWSER_DESKTOP=2
unset VIRTUAL_ENV

usage() { echo "Usage: $(basename "$0") [-b] [-a] [-u <path>] [pytest args...]" >&2; exit 1; }

mode="unit"
path=()
while [ $# -gt 0 ]; do
    case "$1" in
        -b) mode="behavior"; shift ;;
        -a) mode=""; shift ;;
        -u) path=("$2"); shift 2 ;;
        -h) usage ;;
        --) shift; break ;;
        -*) break ;;  # unknown flag → pass through to pytest
        *) break ;;   # positional arg → pass through
    esac
done

uv run pytest ${mode:+-m "$mode"} "${path[@]}" "$@" 2>&1 | tee test.log

