#!/usr/bin/env bash
set -euo pipefail

unset VIRTUAL_ENV

usage() { echo "Usage: $(basename "$0") [-b] [-a] [-d] [-u <path>] [pytest args...]" >&2; exit 1; }

mode=""
path=()
headed=""
while [ $# -gt 0 ]; do
    case "$1" in
        -b) mode="-m behavior"; shift ;;
        -a) mode='-m ""'; shift ;;
        -d) headed="--headed"; shift ;;
        -u) path=("$2"); shift 2 ;;
        -h) usage ;;
        --) shift; break ;;
        -*) break ;;  # unknown flag → pass through to pytest
        *) break ;;   # positional arg → pass through
    esac
done

exec uv run pytest ${mode:-} "$headed" "${path[@]}" "$@"

